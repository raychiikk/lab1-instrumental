{
    "source": {
    "include": ["src"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(node_modules|dist|build|\\.test\\.js|\\.test\\.jsx)"
    },
    "plugins": ["plugins/markdown"],
    "opts": {
    "destination": "dist/docs/",
    "recurse": true,
    "readme": "README.md",
    "template": "node_modules/docdash"
    },
    "templates": {
    "default": {
        "outputSourceFiles": false
    }
    },
    "docdash": {
    "static": true,
    "search": true,
    "collapse": true,
    "sectionOrder": [
        "Global",
        "Modules",
        "Typedefs"
    ],
    "menu": {
        "GitHub Repository": {
        "href": "https://github.com/raychiikk/lab1-instrumental",
        "target": "_blank",
        "class": "menu-item"
        }
    }
    }
}